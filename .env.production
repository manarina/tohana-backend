# ==========================================
# TOHANA BACKEND - PRODUCTION
# ==========================================

# Server
PORT=3000
NODE_ENV=production
API_PREFIX=/api/v1

# Database (sera remplacé par Render)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=tohana_db
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MAX_CONNECTIONS=20
DB_CONNECTION_TIMEOUT=30000

# JWT
JWT_SECRET=votre_secret_jwt_super_securise
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=votre_refresh_secret
JWT_REFRESH_EXPIRATION=30d

# CORS
CORS_ORIGIN=https://tohana-frontend.onrender.com,https://tohana.vercel.app
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_CREDENTIALS=true

# GraphQL
GRAPHQL_PLAYGROUND=false
GRAPHQL_INTROSPECTION=false
GRAPHQL_SORT_SCHEMA=true

# Email (Ethereal ou SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=votre_user_ethereal
SMTP_PASSWORD=votre_password_ethereal
SMTP_FROM=noreply@tohana.mg
FRONTEND_URL=https://tohana-frontend.onrender.com

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
BLOCK_TIME_MINUTES=15