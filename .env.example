# ==========================================
# TOHANA BACKEND - ENVIRONMENT VARIABLES
# COPY THIS FILE TO .env AND MODIFY VALUES
# ==========================================

# ---------------------
# SERVER CONFIGURATION
# ---------------------
# Port on which the server will run
PORT=3000

# Environment: development, production, test
NODE_ENV=development

# API prefix for versioning
API_PREFIX=/api/v1

# ---------------------
# DATABASE CONFIGURATION
# ---------------------
# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_DATABASE=tohana_db

# Database synchronization (auto-create tables)
# Set to false in production
DB_SYNCHRONIZE=true

# Database query logging
DB_LOGGING=true

# Maximum connections in pool
DB_MAX_CONNECTIONS=20

# Connection timeout in milliseconds
DB_CONNECTION_TIMEOUT=30000

# ---------------------
# JWT AUTHENTICATION
# ---------------------
# Secret key for JWT signing (CHANGE THIS!)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_please_use_a_strong_key

# Token expiration
# Examples: 7d (7 days), 24h (24 hours), 60m (60 minutes)
JWT_EXPIRATION=7d

# Refresh token secret (CHANGE THIS!)
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_too
JWT_REFRESH_EXPIRATION=30d

# ---------------------
# CORS CONFIGURATION
# ---------------------
# Allowed origins (comma separated)
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Allowed HTTP methods
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Allow credentials (cookies, authorization headers)
CORS_CREDENTIALS=true

# ---------------------
# GRAPHQL CONFIGURATION
# ---------------------
# Enable GraphQL Playground (disable in production)
GRAPHQL_PLAYGROUND=true

# Enable schema introspection (disable in production)
GRAPHQL_INTROSPECTION=true

# Sort schema fields alphabetically
GRAPHQL_SORT_SCHEMA=true

# ---------------------
# SEED & TEST DATA
# ---------------------
# Enable/disable data seeding
SEED_ENABLED=true

# Number of test users to create
SEED_USERS_COUNT=10

# Number of test farms to create
SEED_FARMS_COUNT=50

# Number of plots per farm
SEED_PLOTS_PER_FARM=2

# Number of practices per farm
SEED_PRACTICES_PER_FARM=1

# ---------------------
# LOGGING & MONITORING
# ---------------------
# Log level: debug, info, warn, error
LOG_LEVEL=debug

# Pretty print logs (development only)
LOG_PRETTY=true

# Log access requests
ENABLE_ACCESS_LOGS=true

# Log database queries
ENABLE_QUERY_LOGS=true

# ---------------------
# RATE LIMITING
# ---------------------
# Time window in seconds
RATE_LIMIT_TTL=60

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------
# FILE UPLOAD
# ---------------------
# Maximum file size in bytes (5MB default)
MAX_FILE_SIZE=5242880

# Directory for uploaded files
UPLOAD_DIR=./uploads

# Allowed file types
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ---------------------
# EXTERNAL APIS
# ---------------------
# STAT SANOI Integration
STAT_SANOI_API_URL=https://stat-sanoi.org/api
STAT_SANOI_API_KEY=your_stat_sanoi_api_key

# Meteo Madagascar Integration
METEO_API_URL=https://api.meteo.mg/v1
METEO_API_KEY=your_meteo_api_key

# ---------------------
# EMAIL (optional)
# ---------------------
# SMTP configuration for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@tohana.mg

# ---------------------
# CACHE
# ---------------------
# Redis configuration for caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTL in seconds
CACHE_TTL=3600

# ---------------------
# FEATURE FLAGS
# ---------------------
# Enable/disable features
FEATURE_DASHBOARD=true
FEATURE_EXPORT=true
FEATURE_SEEDS=true
FEATURE_TRAINING=true

# ---------------------
# SECURITY
# ---------------------
# Number of bcrypt rounds for password hashing
BCRYPT_ROUNDS=10

# Minimum password length
PASSWORD_MIN_LENGTH=8

# Session timeout in seconds
SESSION_TIMEOUT=3600

# Maximum login attempts before blocking
MAX_LOGIN_ATTEMPTS=5

# Block time in minutes after max attempts
BLOCK_TIME_MINUTES=15

# ---------------------
# INTERNATIONALIZATION
# ---------------------
# Default language
DEFAULT_LANGUAGE=fr

# Supported languages
SUPPORTED_LANGUAGES=fr,mg,en

# ---------------------
# BACKUP
# ---------------------
# Enable automated backups
BACKUP_ENABLED=true

# Backup cron schedule (daily at midnight)
BACKUP_CRON=0 0 * * *

# Backup directory
BACKUP_DIR=./backups

# Days to keep backups
BACKUP_RETENTION_DAYS=30

# ---------------------
# SENTRY (error tracking)
# ---------------------
# Sentry DSN (optional)
SENTRY_DSN=

# Sentry environment
SENTRY_ENVIRONMENT=development

# Sentry traces sample rate
SENTRY_TRACES_SAMPLE_RATE=0.1